# For local disposable development only. Change BOTH matching passwords.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://parking:change-this-local-password@127.0.0.1:5432/parking
# Opt in ONLY when intentionally resetting the local disposable project tables:
# ALLOW_DB_RESET=local-disposable

# Official GeoPlatform geocoding. No API key required. Durations in milliseconds.
GEOCODING_BASE_URL=https://data.geopf.fr/geocodage/
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_MS=86400000
GEOCODING_EMPTY_CACHE_TTL_MS=30000
GEOCODING_CACHE_MAX_ENTRIES=500
GEOCODING_RATE_LIMIT=5
GEOCODING_MAX_QUEUE_WAIT_MS=1000
GEOCODING_MAX_RETRIES=1
GEOCODING_RETRY_BASE_MS=500
GEOCODING_DEFAULT_RETRY_AFTER_MS=1000
GEOCODING_MIN_AUTOCOMPLETE_CHARS=3
GEOCODING_DEBOUNCE_MS=300
GEOCODING_MAX_RESULTS=10
GEOCODING_DEFAULT_RESULTS=5

# DiaLog public XML, no authentication; durations in milliseconds.
DIALOG_TIMEOUT_MS=60000
DIALOG_FRESHNESS_MS=86400000
DIALOG_MAX_BYTES=134217728
# Valid range 0..15 metres, for Point/LineString only.
DIALOG_SPATIAL_TOLERANCE_METERS=5
