{
  "name": "jepeuxstationner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.e2e.json",
    "test": "npm run build:core && node --test dist/tests/*.test.js",
    "demo": "npm run build:core && node dist/apps/demo/src/index.js",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "test:db": "node --env-file-if-exists=.env scripts/db.mjs test",
    "db:wait": "node --env-file-if-exists=.env scripts/db.mjs wait",
    "db:check": "node --env-file-if-exists=.env scripts/db.mjs check",
    "db:reset": "node --env-file-if-exists=.env scripts/db.mjs reset",
    "test:integration": "npm run build:core && node --env-file-if-exists=.env --test dist/tests/integration/*.test.js",
    "db:explain": "node --env-file-if-exists=.env scripts/db.mjs explain",
    "validate": "npm run typecheck && npm test && npm run demo && npm run build:web",
    "validate:db": "npm run db:wait && npm run db:check && npm run db:migrate && npm run test:db && npm run test:integration && npm run db:explain",
    "test:geocoding": "npm run build:core && node --test dist/tests/geocoding.test.js",
    "test:geocoding:live": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env --test --test-concurrency=1 dist/tests/live/geocoding.live.test.js",
    "demo:geocode": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env dist/apps/demo/src/geocode.js",
    "sync:dialog": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env dist/apps/demo/src/sync-dialog.js",
    "test:dialog": "npm run build:core && node --test dist/tests/dialog.test.js",
    "test:dialog:live": "npm run build:core && node --use-env-proxy --test dist/tests/live/dialog.live.test.js",
    "sync:lyon:parking-rules": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env dist/apps/demo/src/sync-lyon.js parking-rules",
    "sync:lyon:facilities": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env dist/apps/demo/src/sync-lyon.js facilities",
    "lyon:coverage": "npm run build:core && node --use-env-proxy dist/apps/demo/src/sync-lyon.js coverage",
    "test:lyon": "npm run build:core && node --test dist/tests/lyon*.test.js",
    "test:lyon:live": "npm run build:core && node --use-env-proxy --test --test-concurrency=1 dist/tests/live/lyon.live.test.js",
    "check:parking": "npm run build:core && node --use-env-proxy --env-file-if-exists=.env dist/apps/demo/src/check-parking.js",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev": "node scripts/dev-web.mjs",
    "demo:web": "node scripts/dev-web.mjs --demo",
    "start": "node --use-env-proxy --env-file-if-exists=.env dist/apps/web/server/start.js",
    "test:api": "npm run build:core && node --test dist/tests/api.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sax": "1.2.7",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "date-holidays": "3.36.0",
    "maplibre-gl": "6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sax": "1.6.1"
  }
}
